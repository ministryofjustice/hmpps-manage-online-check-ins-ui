{% extends "../_form.njk" %}
{% set pageTitleText = "When would you like " + case.name.forename + " to complete their first online check in?" %}
{% if errorMessages and errorMessages | length %}
  {% set pageTitle = makePageTitle({
    pageHeading: ["Error: " + pageTitleText]
  }) %}
{% else %}
  {% set pageTitle = makePageTitle({
    pageHeading: [pageTitleText]
  }) %}
{% endif %}
{% set backLink = backLink %}
{# During a check-your-answers edit, cancelling returns to the summary, which restores the ad-hoc
   answer this date would have replaced. The first pass has nothing to cancel back to. #}
{% set showAnchorLink = true if cya else false %}
{% set formAnchorLink = '/case/' + crn + '/appointments/' + id + '/check-in/checkin-summary' %}
{% set formAnchorText = 'Cancel and go back' %}

{% block form %}
<div class="govuk-form-group">
    <input type="hidden" name="checkInMinDate" value="{{checkInMinDate}}">
    {{ mojDatePicker({
        name: "date",
        label: {
            text: pageTitleText,
            classes: "govuk-label--l",
            isPageHeading: true
        },
        hint: {
            text: "For example, 17/5/2024. They will get a notification to use online check ins from this date."
        },
        formGroup: {
            classes: "govuk-!-margin-bottom-3",
            attributes: {
                'data-qa': 'checkInDate'
            }
        },
        minDate: checkInMinDate
    } | decorateFormAttributes(['esupervision', crn, id, 'checkins', 'date'])) }}
</div>
{% endblock %}
