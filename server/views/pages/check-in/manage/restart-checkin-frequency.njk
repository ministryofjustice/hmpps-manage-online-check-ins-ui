{% extends "../../_form.njk" %}
{% set title = "Online check in settings" %}
{% if errorMessages and errorMessages | length %}
  {% set pageTitle = makePageTitle({
    pageHeading: ["Error: " + title]
  }) %}
{% else %}
  {% set pageTitle = makePageTitle({
    pageHeading: [title]
  }) %}
{% endif %}
{% set backLink = '/case/' + crn + '/appointments/check-in/manage/' + id if not cya else '/case/' + crn + '/appointments/check-in/manage/' + id + '/restart-summary' %}
{% set radioLabel =  "How often would you like "+ case.name.forename + " to check in?" %}
{% set buttonText =  "Continue" %}

{% block form %}
    {{ govukRadios({
        fieldset: {
            legend: {
                text: radioLabel ,
                classes: "govuk-label--m govuk-!-font-weight-bold"
            }
        },
        formGroup: {
            attributes: {
                'data-qa': 'checkInFrequency'
            }
        },
        items: [
            {
                value: "WEEKLY",
                text: "Every week"
            },
            {
                value: "TWO_WEEKS",
                text: "Every 2 weeks"
            },
            {
                value: "FOUR_WEEKS",
                text: "Every 4 weeks"
            },
            {
                value: "EIGHT_WEEKS",
                text: "Every 8 weeks"
            },
            {
                value: "AD_HOC",
                text: "I'll schedule them one at a time"
            }
        ]
    } | decorateFormAttributes(['esupervision', crn, id, 'restartCheckin', 'interval'])) }}
{% endblock %}
