{% extends "../../_form.njk" %}
{% set title = "Online check in settings" %}
{% if errorMessages and errorMessages | length %}
  {% set pageTitle = makePageTitle({
    pageHeading: ["Error: " + title]
  }) %}
{% else %}
  {% set pageTitle = makePageTitle({
    pageHeading: [title]
  }) %}
{% endif %}
{% set backLink = '/case/' + crn + '/appointments/check-in/manage/' + id + '/restart-checkin' if not cya else '/case/' + crn + '/appointments/check-in/manage/' + id + '/restart-summary' %}
{% set buttonText =  "Continue" %}

{% block form %}
    {{ mojDatePicker({
        name: "date",
        label: {
            text: "When would you like " + case.name.forename + " to complete their next online check in?",
            classes: "govuk-label--s govuk-!-margin-bottom-3"
        },
        formGroup: {
            classes: "govuk-!-margin-bottom-3",
            attributes: {
                'data-qa': 'checkInDate'
            }
        },
        minDate: checkInMinDate
    } | decorateFormAttributes(['esupervision', crn, id, 'restartCheckin', 'date'])) }}

    <input type="hidden" name="checkInMinDate" value="{{checkInMinDate}}">
{% endblock %}
