{% extends "../../_form.njk" %}
{% set pageTitleText = "When would you like the person to complete their next online check in?" %}
{% set pageTitleTextWithName = "When would you like " + case.name.forename + " to complete their next online check in?" %}

{% if errorMessages and errorMessages | length %}
  {% set pageTitle = makePageTitle({
    pageHeading: ["Error: " + pageTitleText]
  }) %}
{% else %}
  {% set pageTitle = makePageTitle({
    pageHeading: [pageTitleText]
  }) %}
{% endif %}
{# Set by the controller and the validator: the manage page for a scheduled person changing their
   date, the frequency page for an ad-hoc person moving to an interval. #}
{% set backLink = backLink %}
{% set buttonText =  "Save changes" %}
{% set showAnchorLink = true %}
{% set formAnchorLink = backLink %}
{% set formAnchorText = "Cancel and go back" %}

{% block form %}
<div class="govuk-form-group">
    <input type="hidden" name="checkInMinDate" value="{{checkInMinDate}}">
    {{ mojDatePicker({
        label: {
            text: pageTitleTextWithName,
            classes: "govuk-label--l",
            isPageHeading: true,
            attributes: {
                'data-qa': 'pageHeading'
            }
        },
        hint: {
            text: "For example, 17/5/2024. They will get a notification to use online check ins from this date."
        },
        formGroup: {
            classes: "govuk-!-margin-bottom-3",
            attributes: {
                'data-qa': 'checkInDate'
            }
        },
        minDate: checkInMinDate
    } | decorateFormAttributes(['esupervision', crn, id, 'manageCheckin', 'date'])) }}
</div>
{% endblock %}
