{% extends "../../_form.njk" %}
{% set overviewLink = managePeopleOnProbationUrl + '/case/' + crn + '/appointments/check-in/manage/' + id %}
{% set backLink = overviewLink %}
{% set buttonText = "Cancel online check in" %}
{% set title = "Cancel upcoming online check in for " + case.name.forename %}
{% set pageTitleText = "Cancel upcoming online check in for the person" %}
{% if errorMessages and errorMessages | length %}
  {% set pageTitle = makePageTitle({
    pageHeading: ["Error: " + pageTitleText]
  }) %}
{% else %}
  {% set pageTitle = makePageTitle({
    pageHeading: [pageTitleText]
  }) %}
{% endif %}
{% set showAnchorLink = true %}
{% set formAnchorLink = overviewLink %}
{% set formAnchorText = "Go back to online check ins" %}

{% block form %}

        <p class="govuk-body" data-qa="cancel-checkin-intro">
            <a href="https://probation-check-in.hmpps.service.justice.gov.uk/practitioner-guidance/stopping-cancelling-and-restarting-check-ins" class="govuk-link" rel="nofollow" target="_blank">Learn more about cancelling an online check in (opens in new tab).</a>
        </p>

        {{ govukTextarea({
            formGroup: {
                attributes: { "data-qa": "cancel-checkin-reason"}
            },
            label: {
                text: "Reason for cancelling",
                classes: 'govuk-label--m govuk-!-margin-bottom-3'
            },
            hint: {
                text: case.name.forename + " will receive a message telling them this check in has been cancelled. "
            }
        } | decorateFormAttributes(['esupervision', crn, id, 'manageCheckin', 'cancelCheckinReason'])) }}

        {{ govukRadios({
            fieldset: {
                legend: {
                    text: 'Does the reason for cancelling include sensitive information?',
                    classes: "govuk-fieldset__legend govuk-fieldset__legend--m"
                }
            },
            hint: {
                text: 'This is information that you believe must be recorded but not shared with a person on probation. If they make a request for their record, the Data Protection Team will decide whether the information can be shared.'
            },
            formGroup: {
                attributes: {
                    'data-qa': 'cancel-checkin-sensitive'
                }
            },
            items: [
                {
                    value: true,
                    text: "Yes, it includes sensitive information"
                },
                {
                    value: false,
                    text: "No, it is not sensitive"
                }
            ]
        } | decorateFormAttributes(['esupervision', crn, id, 'manageCheckin', 'cancelCheckinSensitive'])) }}

{% endblock %}
