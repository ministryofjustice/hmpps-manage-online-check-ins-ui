{% extends "../../_form.njk" %}
{% set pageTitleText = "Do you have one or more people who started using online check ins before 1 October 2026?" %}
{% if errorMessages and errorMessages | length %}
  {% set pageTitle = makePageTitle({
    pageHeading: ["Error: " + pageTitleText]
  }) %}
{% else %}
  {% set pageTitle = makePageTitle({
    pageHeading: [pageTitleText]
  }) %}
{% endif %}
{% set sessionKey = sessionKey or 'checkins' %}
{% set flowPathPrefix = flowPathPrefix or '/case/' + crn + '/appointments/' + id + '/check-in/' %}
{% set backLink = flowPathPrefix + 'eligibility-check' %}
{% set buttonText = "Continue" %}
{% set radioText = "Do you have one or more people who started using online check ins before 1 October 2026?" %}
{% set currentChoice = data.esupervision[crn][id][sessionKey].pilotCheck %}

{% block form %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">

            {{ govukRadios({
                name: "esupervision[" + crn + "][" + id + "][" + sessionKey + "][pilotCheck]",
                fieldset: {
                    legend: {
                        text: radioText,
                        classes: "govuk-fieldset__legend--l",
                        isPageHeading: false
                    }
                },
                formGroup: {
                    attributes: {
                        'data-qa': 'pilot-check'
                    }
                },
                errorMessage: {
                                    text: errorMessages["esupervision-" + crn + "-" + id + "-" + sessionKey + "-pilotCheck"]
                                } if errorMessages["esupervision-" + crn + "-" + id + "-" + sessionKey + "-pilotCheck"],
                items: [
                    {
                        value: 'true',
                        text: "Yes",
                        checked: currentChoice == 'true'
                    },
                    {
                        value: 'false',
                        text: "No",
                        checked: currentChoice == 'false'
                    }
                ]
            } | decorateFormAttributes(['esupervision', crn, id, sessionKey, 'pilotCheck'])) }}
        </div>
    </div>
{% endblock %}
